{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    // Spike code, the npm placeholder and the issue-seeding data predate the tooling.
    "includes": [
      "**",
      "!bench",
      "!srcatlas-placeholder",
      "!scripts/backlog.json",
      // Deliberately unparsable: the fixture for core.parse-error.
      "!fixtures/analyzer-parse-error/src/broken.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // CLAUDE.md section 7: no `any` (use `unknown` and narrow); no non-null assertions outside tests.
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      // Fixtures copy real NestJS code: parameter decorators, constructor-injected members that are
      // never read, and dynamic modules that are classes with only static methods.
      "includes": ["fixtures/**"],
      "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } },
      "linter": {
        "rules": {
          "complexity": { "noStaticOnlyClass": "off" },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedPrivateClassMembers": "off"
          }
        }
      }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
